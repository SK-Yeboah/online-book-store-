# Copy this file to .env and fill in your values.
# Generate a JWT secret with: openssl rand -hex 32

SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_book_store
DB_USERNAME=root
DB_PASSWORD=your_password_here

# JWT — required, no default (app will not start without this)
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32

# Token expiry (milliseconds)
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Account lockout
SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION_MINUTES=15
SECURITY_LOCKOUT_RESET_AFTER_HOURS=24

# Rate limiting — production-like default (60/min).
# For heavy k6 runs only, temporarily raise (e.g. 100000) then restore.
SECURITY_RATE_LIMIT_CAPACITY=60
SECURITY_RATE_LIMIT_REFILL_PER_MINUTE=60

# Paystack (test keys from https://dashboard.paystack.com — keep real keys in .env only)
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

# Payments — Compose defaults to mock for local/E2E; use paystack for real checkout
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=GHS
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Actuator — local Prometheus scrape without JWT (prod forces false)
ACTUATOR_PROMETHEUS_PUBLIC=true
SECURITY_SWAGGER_PUBLIC=true

# Grafana (local monitoring stack — docker compose prometheus + grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Production / deploy (Secrets Manager / ECS) — see docs/production-checklist.md
# SPRING_PROFILES_ACTIVE=prod
# PAYMENT_PROVIDER=paystack
# PAYMENT_CALLBACK_URL=https://app.example.com/payment/callback
# CORS_ALLOWED_ORIGINS=https://app.example.com
# ACTUATOR_PROMETHEUS_PUBLIC=false
# SECURITY_SWAGGER_PUBLIC=false
